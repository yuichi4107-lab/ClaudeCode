# ============================================================
# JP-DAYTRADE-v1 設定テンプレート
# このファイルを config/.env にコピーして値を設定してください
# config/.env は .gitignore で管理対象外にしています
# ============================================================

# -------------------------------------------------------
# J-Quants API（必須: 日足・銘柄マスター取得）
# -------------------------------------------------------
# 取得方法: https://jpx.gitbook.io/j-quants-ja
# 1. https://jpx.gitbook.io/j-quants-ja/ で無料登録
# 2. ダッシュボードのトークン管理 > リフレッシュトークン発行
JQUANTS_REFRESH_TOKEN=your_refresh_token_here

# -------------------------------------------------------
# kabu ステーション API（Phase 3以降: リアルタイム接続用）
# -------------------------------------------------------
# kabuステーションアプリの設定 > API > APIパスワード
KABU_API_PASSWORD=your_kabu_api_password_here

# kabu API URL（通常は変更不要）
# 本番: http://localhost:18080（Surface でkabuステーション起動時）
# テスト/モック: http://localhost:18081
KABU_API_BASE_URL=http://localhost:18080
KABU_MOCK_BASE_URL=http://localhost:18081

# -------------------------------------------------------
# Telegram 通知（Phase 4以降）
# -------------------------------------------------------
# 既存の ai-trade-system/.env の TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID と同じ値
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -------------------------------------------------------
# デバッグ設定
# -------------------------------------------------------
# ログレベル: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
