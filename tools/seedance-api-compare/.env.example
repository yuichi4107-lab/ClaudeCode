# このファイルを .env にコピーして、取得したAPIキーを貼り付ける
# cp .env.example .env

# Atlas Cloud: https://www.atlascloud.ai/ でサインアップ → Dashboard → API Keys
ATLAS_CLOUD_API_KEY=

# EvoLink: https://evolink.ai/ でサインアップ → Get API Key
EVOLINK_API_KEY=

# モデルIDが違う場合はここで上書き(エラーメッセージに正しいIDが出ることが多い)
# ATLAS_MODEL=seedance-2.0
# EVOLINK_MODEL=seedance-2.0-text-to-video
