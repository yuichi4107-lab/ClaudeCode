telegram:
  # bot_token: BotFather でトークンを発行する手順
  #   1. Telegram で @BotFather を開き /newbot を送信
  #   2. ボット名・ユーザー名を入力するとトークンが発行される
  #   3. 形式: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
  bot_token: ""

  # chat_id: 通知先チャットIDの確認方法
  #   方法A: Telegram で @userinfobot に /start を送ると自分の chat_id が表示される
  #   方法B: ブラウザで https://api.telegram.org/bot<TOKEN>/getUpdates を開き
  #          ボットにメッセージを送った後リロードすると "id" フィールドで確認できる
  #   形式: 数値文字列（例: "123456789" または "-100123456789" はグループ）
  chat_id: ""
