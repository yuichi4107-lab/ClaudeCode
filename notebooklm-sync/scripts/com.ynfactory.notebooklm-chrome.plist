<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ynfactory.notebooklm-chrome</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/yuichi/notebooklm-sync/scripts/start_chrome_mac.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>NOTEBOOKLM_HEADLESS</key>
        <string>1</string>
        <key>NOTEBOOKLM_CDP_PORT</key>
        <string>9222</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/yuichi/notebooklm-sync/logs/chrome-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yuichi/notebooklm-sync/logs/chrome-stderr.log</string>
