# ~/shorts-factory/secrets.yaml に置く（Drive外・chmod 600）
# SNS(X/Meta)の認証は .company/engineering/sns-credentials/.env を自動参照するためここには不要

openai_api_key: ""           # 任意: 入れると llm.provider=openai / images.provider=openai が使える
gemini_api_key: ""           # 任意: 入れると images.provider=gemini（NanoBanana2）が使える

telegram:
  bot_token: "123456:ABC..." # 承認・通知用bot（暫定: @mnb121_bot を流用中。専用bot推奨）
  chat_id: "8571447808"

atlas_cloud:
  api_key: ""  # Seedance 2.0動画背景生成用。未設定なら自動的に静止画版へフォールバック
